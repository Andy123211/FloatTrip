# 高德 Web 服务 Key（必填）
AMAP_API_KEY=

# 高德 Web端(JS API) Key（前端地图用，可选）
AMAP_JS_KEY=

# 高德 JS API 安全密钥 securityJsCode（与 JS Key 配套，可选）
AMAP_JS_SECURITY_CODE=

# LLM 提供商（可选，默认 "deepseek"，支持 "deepseek"、"doubao"）
# LLM_PROVIDER=deepseek

# DeepSeek API Key（如果使用 DeepSeek 提供商，此项必填）
DEEPSEEK_API_KEY=

# DeepSeek 模型（可选，默认 deepseek-v4-flash）
# DEEPSEEK_MODEL=deepseek-v4-flash
# 主 Agent / 规划 Agent 默认继承 DEEPSEEK_MODEL，并启用 thinking=enabled
# MAIN_AGENT_MODEL=deepseek-v4-pro
# MAIN_AGENT_REASONING_EFFORT=high
# PLANNING_AGENT_MODEL=deepseek-v4-pro
# PLANNING_AGENT_REASONING_EFFORT=high
# 可选：候选景点语义采用单次非 thinking 结构化调用，默认继承规划模型
# PLANNING_CANDIDATE_MODEL=deepseek-v4-flash
# PLANNING_CANDIDATE_TIMEOUT_SECONDS=45
# 景点贴士采用单次非 thinking 结构化调用；默认 30 秒
# PLANNING_SPOT_TIPS_MODEL=deepseek-v4-flash
# PLANNING_SPOT_TIPS_TIMEOUT_SECONDS=30

# 豆包 API Key（如果使用豆包提供商，此项必填）
# DOUBAO_API_KEY=

# 豆包模型（可选，默认 doubao-pro-4k）
# DOUBAO_MODEL=doubao-pro-4k

# Redis 缓存（可选，不配置则禁用缓存）
REDIS_URL=redis://localhost:6379/0

# Agent Runtime 并发与 checkpoint（均可选，以下为默认值）
# Chat 主 Agent 迁移开关：decision（默认，可回退）或 react（LangChain create_agent）
# CHAT_AGENT_MODE=react
# RUNTIME_CHAT_CONCURRENCY=8
# RUNTIME_PLANNING_CONCURRENCY=2
# RUNTIME_PLANNING_PER_USER=2
# RUNTIME_LLM_CONCURRENCY=8
# RUNTIME_AMAP_CONCURRENCY=8
# RUNTIME_CHECKPOINT_DB=data/langgraph-checkpoints.db
# 逗号分隔的新评分版本；复用正式 Run 冻结候选池异步求解，不阻塞结果
# PLANNING_SHADOW_PROFILES=

# Chat 会话记忆、压缩与提取（均可选，以下为默认值）
# CHAT_CONTEXT_BUDGET_TOKENS=3000
# CHAT_SUMMARY_TRIGGER_TOKENS=2600
# CHAT_SUMMARY_TARGET_TOKENS=600
# CHAT_RECENT_TURNS=6
# CHAT_MAX_MESSAGE_TOKENS=1200
# CHAT_SUMMARY_MODEL=
# MEMORY_EXTRACTION_MODEL=
# MEMORY_EXTRACTION_INPUT_TOKENS=6000
# PLANNING_MEMORY_MATCH_MODEL=

# HTTP 代理（可选）
# HTTPS_PROXY=http://127.0.0.1:7890

# LangSmith 追踪（可选，接入后可在 smith.langchain.com 查看 Agent 链路）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=ls__你的key
# LANGCHAIN_PROJECT=floattrip-dev
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
